# The Default YouTube playlist URL you want to sync
YOUTUBE_PLAYLIST_URL=https://www.youtube.com/playlist?list=YOUR_PLAYLIST_HERE
PORT=8000

# Replace with your Discord application's client ID if you want to use your own name instead of the the github link Otherwise, leave it as is.
DISCORD_CLIENT_ID=1542223919547678931

# Required for Spotify playlist/album/track import. Spotify is only ever used
# to read metadata (titles, artists, artwork, ordering) - create a free app at
# https://developer.spotify.com/dashboard to get these, then paste them below.

# https://developer.spotify.com/dashboard/create
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
 
